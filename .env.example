# Woodpecker server — set these before running `roadie start --dev`
#
# WOODPECKER_HOST: public URL Woodpecker will use for GitHub webhook callbacks.
#   On this machine: https://rogueone.tailbb1c76.ts.net
#   On a new machine: your Tailscale or public hostname on port 1984.
WOODPECKER_HOST=https://<your-host>

# WOODPECKER_ADMIN: GitHub username to grant admin access in Woodpecker.
WOODPECKER_ADMIN=edtbl76

# Private key symlink — create once per machine, update on key rotation:
#   ln -sf stud-io-woodpecker.<date>.private-key.pem woodpecker-private-key.pem
# The actual key file is gitignored; only the stable symlink name is referenced
# in docker-compose.dev.yml.
