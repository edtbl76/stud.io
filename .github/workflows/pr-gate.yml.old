name: PR Gate

on:
  workflow_dispatch:
  pull_request:
    branches: [main]
  push:
    branches: [main]

env:
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24: true
  # Isolate CI test databases from local dev to prevent concurrent run collisions.
  # e2e shards become controlroomdb_test_ci_0..3; perf backend uses controlroomdb_test_ci.
  ROADIE_TEST_DB_SOURCE: controlroomdb_test_ci
  ROADIE_BUILD_DATABASES: controlroomdb_test_ci

# Cancel in-progress runs on the same branch when a new push arrives
concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  # ── Job 1: Provision CI test database ────────────────────────────────────
  # Creates controlroomdb_test_ci if absent, then applies the current schema.
  # All other jobs depend on this so the schema is always up to date before
  # any test run touches it.
  build:
    name: "Build (provision CI schema)"
    runs-on: [self-hosted, linux, controlroom]
    steps:
      - uses: actions/checkout@v4
      - name: Create CI test database if absent
        run: |
          docker exec studio_db psql -U studio -lqt | cut -d'|' -f1 | grep -qw controlroomdb_test_ci || \
            docker exec studio_db createdb -U studio controlroomdb_test_ci
      - name: Apply schema to CI test database
        run: roadie build --schema-only

  # ── Job 2: Unit + PBT ────────────────────────────────────────────────────
  # tsc · jest · ruff · bandit · pytest · fast-check · hypothesis
  # pytest uses transaction-per-test rollback so controlroomdb_test is safe
  # for concurrent access; unit tests do not need the CI namespace.
  unit-pbt:
    name: "Unit + PBT"
    runs-on: [self-hosted, linux, controlroom]
    needs: build
    steps:
      - uses: actions/checkout@v4
      - name: Run unit tests
        run: roadie test unit
      - name: Run property-based tests
        run: roadie test pbt

  # ── Job 3: Security scans ─────────────────────────────────────────────────
  # sonar · trivy · secrets · headers — no DB contact
  scan:
    name: "Scans (sonar · trivy · secrets · headers)"
    runs-on: [self-hosted, linux, controlroom]
    needs: build
    steps:
      - uses: actions/checkout@v4
      - name: Install frontend dependencies
        working-directory: app/controlroom_frontend
        run: npm ci
      - name: Verify dev stack is healthy
        run: |
          curl -sf http://localhost:1969 || \
            { echo "Dev stack (SonarQube) is not running. Run 'roadie start --dev' on the runner."; exit 1; }
      - name: Run security scans
        env:
          SONAR_TOKEN: ${{ secrets.SONAR_TOKEN }}
        run: roadie test scan --gate

  # ── Job 4: E2E ────────────────────────────────────────────────────────────
  # Playwright shards — clones controlroomdb_test_ci → controlroomdb_test_ci_0..3
  e2e:
    name: "E2E (Playwright)"
    runs-on: [self-hosted, linux, controlroom]
    needs: build
    steps:
      - uses: actions/checkout@v4
      - name: Run E2E tests
        run: roadie test e2e

  # ── Job 5: Performance ────────────────────────────────────────────────────
  # benchmarks · k6 · Lighthouse — push to main only, non-blocking
  perf:
    name: "Performance (benchmarks · k6 · Lighthouse)"
    runs-on: [self-hosted, linux, controlroom]
    needs: [unit-pbt, scan, e2e]
    if: github.event_name == 'push' && github.ref == 'refs/heads/main' || github.event_name == 'workflow_dispatch'
    steps:
      - uses: actions/checkout@v4
      - name: Run performance suite
        run: roadie test perf
