# Trivy vulnerability suppressions.
# Each entry requires a justification consistent with the project's security posture.
# Review this file when upgrading base images or dependencies.

# CVE-2024-23342: ecdsa — Minerva timing attack on ECDSA keys
# Suppressed: transitive dep of python-jose; app uses HS256 (HMAC) JWTs exclusively,
# not EC keys. No fix available upstream. Consistent with pip-audit suppression.
CVE-2024-23342

# CVE-2025-69720: ncurses — buffer overflow in python:3.12-slim (debian 13.4)
# Suppressed: no fix available in debian 13.4. ncurses is not used by the application;
# it is present as an indirect OS dependency.
CVE-2025-69720

# CVE-2026-4878: libcap — privilege escalation via TOCTOU in cap_set_file()
# Suppressed: no fix available in debian 13.4. libcap is an indirect OS dep;
# the container runs as non-root (appuser) and does not call cap_set_file().
CVE-2026-4878

# CVE-2026-29111: systemd — arbitrary code execution via spurious IPC
# Suppressed: no fix available. systemd is an indirect OS dep in python:3.12-slim;
# it is not reachable from the application and the container runs as non-root (appuser).
CVE-2026-29111

# CVE-2026-4046: glibc — DoS via iconv() with specific character sets (libc-bin, libc6)
# Suppressed: fix_deferred in debian 13.4 — no patched version available.
# glibc iconv is not invoked by the application; present only as an OS base image dep.
CVE-2026-4046

# CVE-2026-40356: krb5 — DoS via integer underflow leading to out-of-bounds read (CWE-191)
# in MIT Kerberos 5 (libgssapi-krb5-2). Upstream fix available in krb5 >= 1.22.3; the
# container (debian 13.4, trixie) ships 1.21.3-5 with no patched debian package available yet.
# libgssapi-krb5-2 is an indirect OS dependency — not reachable from the application, which
# uses JWT/bcrypt authentication exclusively. Revisit when debian 13.4 packages krb5 >= 1.22.3.
CVE-2026-40356

# Frontend npm devDependency CVEs
# The following packages are transitive dependencies of build/test tooling
# (jest, playwright, next build) installed in the dev container. They are not
# in the HTTP request path. npm audit --audit-level=critical handles
# critical-severity npm CVEs at pre-commit time.

# CVE-2024-21538: cross-spawn — ReDoS via regex
CVE-2024-21538

# CVE-2025-64756: glob — command injection via malicious path
CVE-2025-64756

# CVE-2026-26996, CVE-2026-27903, CVE-2026-27904: minimatch — DoS variants
CVE-2026-26996
CVE-2026-27903
CVE-2026-27904

# CVE-2026-23745, CVE-2026-23950, CVE-2026-24842, CVE-2026-26960,
# CVE-2026-29786, CVE-2026-31802: node-tar — path traversal / file overwrite variants
CVE-2026-23745
CVE-2026-23950
CVE-2026-24842
CVE-2026-26960
CVE-2026-29786
CVE-2026-31802

# CVE-2026-48779 (HIGH): ws — memory-exhaustion DoS from tiny fragments / data chunks.
# Audit (2026-06-16): `npm ls ws` shows ws is pulled ONLY by build/test tooling, never the
# runtime/request path — ws@7.5.10 via @next/bundle-analyzer (webpack-bundle-analyzer) and
# lighthouse; ws@8.19.0 via jest-environment-jsdom (jsdom) and lighthouse (puppeteer-core).
# These run at build/test/perf-audit time in the dev container only; the production Next.js
# server does not depend on ws. Fixed upstream in ws 7.5.11 / 8.21.0 — not adopted here to
# avoid forcing a major bump on the 7.x consumers; revisit when bundle-analyzer/jsdom/puppeteer
# widen their ws ranges. Consistent with the dev-tooling suppression rationale above.
CVE-2026-48779

# CVE-2026-48815 (HIGH): sigstore < 4.1.1 — certificateOIDs verification constraint bypass.
# sigstore is bundled inside the npm CLI shipped in the node:20-alpine base image
# (usr/local/lib/node_modules/npm/node_modules/sigstore), NOT an app dependency
# (`npm ls sigstore` is empty). It runs only during npm publish/provenance, never in the
# Next.js request path. Not bumpable via package.json; resolves when node:20-alpine ships
# npm bundling sigstore >= 4.1.1. Consistent with the dev-tooling suppressions above.
CVE-2026-48815

# Perl CVEs in controlroom_backend — no fix available in debian trixie
# Perl is a runtime dependency required by pg backup tooling.
# Suppression accepted pending an upstream patch.
# Revisit when debian trixie ships patched perl 5.40 packages.

# CVE-2026-42496 (CRITICAL): Archive::Tar < 3.08 — symlink extraction attack
CVE-2026-42496

# CVE-2026-8376 (CRITICAL): Perl <= 5.43.10 — heap buffer overflow during compilation
CVE-2026-8376

# CVE-2026-42497 (HIGH): Archive::Tar < 3.08 — hardlink extraction attack
CVE-2026-42497

# CVE-2026-9538 (HIGH): Archive::Tar < 3.10 — memory exhaustion via crafted archive
CVE-2026-9538

# CVE-2026-48962 (HIGH): perl-IO-Compress — arbitrary code execution via attacker-controlled output glob
CVE-2026-48962

# CVE-2026-48959 (HIGH): perl IO::Uncompress::Unzip < 2.220 — CPU exhaustion via crafted zip.
# No fix available in debian trixie. perl is a runtime dep of pg backup tooling; the affected
# Unzip path is not invoked by the application. Revisit when trixie ships patched perl 5.40.
CVE-2026-48959

# SQLite CVEs in controlroom_backend — no fix available in debian trixie
# libsqlite3-0 is an indirect OS dependency only; the application uses PostgreSQL (asyncpg)
# exclusively and never opens a SQLite database. Revisit when trixie ships sqlite3 >= 3.53.2.

# CVE-2026-11822 (HIGH): libsqlite3-0 < 3.53.2 — memory corruption
CVE-2026-11822

# CVE-2026-11824 (HIGH): libsqlite3-0 < 3.53.2 — heap-based buffer overflow
CVE-2026-11824

# Base-image OS CVEs (debian 13.5, python:3.12-slim) — no fix available in trixie.
# Indirect OS dependencies only; controlroom_backend runs as non-root (appuser) and
# none are in the HTTP request path. Revisit when debian trixie ships patched packages.

# CVE-2026-41992 (HIGH): gzip — global buffer overflow in LZH decompression.
# gzip is an OS base tool; the application never decompresses untrusted .lzh archives.
CVE-2026-41992

# CVE-2026-54369 (HIGH): libacl1 — symlink-traversal privilege escalation via libacl.
# Indirect OS dep; non-root container; app performs no ACL ops on attacker-controlled paths.
CVE-2026-54369

# CVE-2026-54371 (HIGH): libattr1 — symlink-traversal privilege escalation via getfattr.
# Indirect OS dep; non-root container; app performs no xattr ops on attacker-controlled paths.
CVE-2026-54371
