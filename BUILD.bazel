load("@buildifier_prebuilt//:rules.bzl", "buildifier")

# Lint and auto-fix all BUILD files
buildifier(name = "buildifier")

# //:unit — hermetic checks only (tsc · jest · ruff · bandit)
# Run with: bazel test //:unit
test_suite(
    name = "unit",
    tests = [
        "//app/controlroom_backend:bandit",
        "//app/controlroom_backend:ruff",
        "//app/controlroom_frontend:jest",
        "//app/controlroom_frontend:tsc",
    ],
)

# //:gate — full suite including infra-dependent targets (manual)
# Run with: bazel test --build_tag_filters=manual //:gate
test_suite(
    name = "gate",
    tags = ["manual"],
    tests = [
        "//:unit",
        "//app/controlroom_backend/tests:pytest",
        "//app/controlroom_frontend/e2e:playwright",
        "//tests:perf",
        "//tests:scan_secrets",
        "//tests:scan_sonar",
        "//tests:scan_trivy",
    ],
)
