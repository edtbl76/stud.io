# Phase 0: sh_test wrapper around run-pytest.sh.
# Requires live PostgreSQL (controlroomdb_test) — tagged external + manual
# so it is excluded from bazel test //... and //:unit.
# Invoke explicitly: bazel test //app/controlroom_backend/tests:pytest

sh_test(
    name = "pytest",
    srcs = ["//tools/bazel:pytest.sh"],
    tags = [
        "external",
        "local",
        "manual",
        "requires-db",
    ],
)
