#!/usr/bin/env bash
set -euo pipefail

VERSION="__VERSION__"
INSTALL_DIR="${INSTALL_DIR:-/usr/local/bin/stud.io/plugin-scanner}"
SYMLINK_PATH="/usr/local/bin/plugin-scanner"
CA_CERT="rootCA.pem"

case "$(uname -m)" in
  arm64|aarch64) BINARY="plugin-scanner-arm64" ;;
  x86_64)        BINARY="plugin-scanner-amd64" ;;
  *) echo "Error: unsupported architecture $(uname -m)" >&2; exit 1 ;;
esac

TARGET="$INSTALL_DIR/plugin-scanner"

# ── Helpers ──────────────────────────────────────────────────────────────────

usage() {
  local code=${1:-0}
  cat <<EOF
Usage: $(basename "$0") [--uninstall] [--help]

Installs plugin-scanner $VERSION to $INSTALL_DIR (requires sudo).
Also installs the ControlRoom CA certificate, sets ca_cert_path, and
configures shell completion. Creates a convenience symlink at $SYMLINK_PATH.

Options:
  --uninstall   Remove plugin-scanner (binary, symlink, and cert config)
  --help        Show this help message

Environment:
  INSTALL_DIR   Override the install location (default: /usr/local/bin/stud.io/plugin-scanner)
EOF
  exit "$code"
}

detect_shell() {
  basename "${SHELL:-/bin/sh}"
}

setup_completion() {
  local shell_name rc line
  shell_name=$(detect_shell)

  case "$shell_name" in
    zsh)
      rc="${HOME}/.zshrc"
      line='source <(plugin-scanner completion zsh)'
      if ! grep -qF "plugin-scanner completion" "$rc" 2>/dev/null; then
        printf '\n# plugin-scanner shell completion\n%s\n' "$line" >> "$rc"
        echo "  Completion: zsh completion added to $rc."
      else
        echo "  Completion: zsh already configured."
      fi
      ;;
    bash)
      rc="${HOME}/.bash_profile"
      line='source <(plugin-scanner completion bash)'
      if ! grep -qF "plugin-scanner completion" "$rc" 2>/dev/null; then
        printf '\n# plugin-scanner shell completion\n%s\n' "$line" >> "$rc"
        echo "  Completion: bash completion added to $rc."
      else
        echo "  Completion: bash already configured."
      fi
      ;;
    fish)
      mkdir -p "${HOME}/.config/fish/completions"
      if "$TARGET" completion fish > "${HOME}/.config/fish/completions/plugin-scanner.fish" 2>/dev/null; then
        echo "  Completion: fish completion installed."
      else
        echo "  Completion: could not install fish completion."
      fi
      ;;
    *)
      echo "  Completion: unknown shell ($SHELL) — run: plugin-scanner completion <shell>"
      ;;
  esac
}

install_ca() {
  if [ ! -f "$CA_CERT" ]; then
    echo "  CA: rootCA.pem not found in archive — skipping."
    return
  fi
  echo "Installing ControlRoom CA certificate (requires sudo)..."
  # Copy cert alongside the binary so the binary can load it explicitly
  sudo cp "$CA_CERT" "$INSTALL_DIR/rootCA.pem"
  sudo chmod 644 "$INSTALL_DIR/rootCA.pem"
  # Also trust it in the system keychain for browsers and curl
  if sudo security add-trusted-cert -d -r trustRoot -k /Library/Keychains/System.keychain "$CA_CERT"; then
    echo "  CA: trusted in system keychain."
  else
    echo "  CA: keychain install failed — binary will load cert from $INSTALL_DIR/rootCA.pem." >&2
  fi
  # Set ca_cert_path so the binary explicitly loads the cert (bypasses keychain access issues)
  if "$TARGET" config set ca_cert_path "$INSTALL_DIR/rootCA.pem" 2>/dev/null; then
    echo "  CA: ca_cert_path set → $INSTALL_DIR/rootCA.pem"
  else
    echo "  CA: could not set ca_cert_path automatically." >&2
    echo "      Run manually: plugin-scanner config set ca_cert_path $INSTALL_DIR/rootCA.pem"
  fi
}

# ── Argument parsing ──────────────────────────────────────────────────────────

UNINSTALL=false
for arg in "$@"; do
  case "$arg" in
    --uninstall) UNINSTALL=true ;;
    --help|-h)   usage 0 ;;
    *) echo "Unknown option: $arg" >&2; usage 2 ;;
  esac
done

# ── Uninstall ─────────────────────────────────────────────────────────────────

if [ "$UNINSTALL" = true ]; then
  if [ -f "$TARGET" ]; then
    sudo rm "$TARGET"
    echo "plugin-scanner removed from $TARGET"
  else
    echo "plugin-scanner not found at $TARGET — nothing to remove."
  fi
  if [ -L "$SYMLINK_PATH" ]; then
    sudo rm "$SYMLINK_PATH"
    echo "Symlink removed: $SYMLINK_PATH"
  fi
  sudo rmdir "$INSTALL_DIR" 2>/dev/null && echo "Removed $INSTALL_DIR" || true
  exit 0
fi

# ── Install ───────────────────────────────────────────────────────────────────

if [ ! -f "$BINARY" ]; then
  echo "Error: $BINARY not found in the current directory." >&2
  echo "Run this script from the extracted zip directory." >&2
  exit 1
fi

# Detect existing installation
if [ -f "$TARGET" ]; then
  EXISTING=$("$TARGET" version 2>/dev/null || echo "unknown")
  if [ "$EXISTING" = "$VERSION" ]; then
    echo "plugin-scanner $VERSION is already installed at $TARGET — nothing to do."
    install_ca
    setup_completion
    exit 0
  else
    echo "Replacing existing plugin-scanner ($EXISTING) with $VERSION..."
  fi
fi

# Remove macOS quarantine flag from the source binary before copying
if xattr -d com.apple.quarantine "$BINARY" 2>/dev/null; then
  echo "Removed macOS quarantine flag."
fi
chmod +x "$BINARY"

echo "Installing to $TARGET (requires sudo)..."
sudo mkdir -p "$INSTALL_DIR"
sudo cp "$BINARY" "$TARGET"
sudo chmod 755 "$TARGET"

# Symlink at /usr/local/bin so the binary is in PATH without shell rc changes
sudo ln -sf "$TARGET" "$SYMLINK_PATH"

echo ""
echo "plugin-scanner $VERSION installed to $TARGET"
echo "Symlinked: $SYMLINK_PATH → $TARGET"

# Smoke test via full path (symlink may not be in PATH in current shell yet)
if "$TARGET" version >/dev/null 2>&1; then
  echo "Smoke test passed: $("$TARGET" version)"
else
  echo "Warning: installed binary did not respond to version" >&2
fi

echo ""
echo "Configuring environment..."
install_ca
setup_completion
echo ""
case "$(detect_shell)" in
  zsh)  echo "Done. To activate completion now: source ~/.zshrc  (or restart your shell)" ;;
  bash) echo "Done. To activate completion now: source ~/.bash_profile  (or restart your shell)" ;;
  fish) echo "Done. To activate completion now: source ~/.config/fish/config.fish  (or restart your shell)" ;;
  *)    echo "Done. Restart your shell to activate completion changes." ;;
esac
