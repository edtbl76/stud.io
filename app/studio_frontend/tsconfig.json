{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "target": "ES2017"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next-e2e/types/**/*.ts",
    ".next-e2e-0/types/**/*.ts",
    ".next-e2e-1/types/**/*.ts",
    ".next-e2e-2/types/**/*.ts",
    ".next-e2e-3/types/**/*.ts",
    ".next-perf/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-e2e-0/dev/types/**/*.ts",
    ".next-e2e-1/dev/types/**/*.ts",
    ".next-e2e-2/dev/types/**/*.ts",
    ".next-e2e-3/dev/types/**/*.ts",
    ".next-perf/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next/dev",
    ".next-e2e/dev",
    ".next-e2e-0/dev",
    ".next-e2e-1/dev",
    ".next-e2e-2/dev",
    ".next-e2e-3/dev",
    ".next-perf/dev"
  ]
}
